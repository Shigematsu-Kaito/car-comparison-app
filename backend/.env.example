# Supabase接続情報
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# アプリケーション設定
APP_NAME=中古車比較アプリ
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# スクレイピング設定
REQUEST_TIMEOUT=30
MAX_RETRY=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
